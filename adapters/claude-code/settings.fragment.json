{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{PYTHON} {KIT}/hooks/context7_reminder.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{PYTHON} {KIT}/adapters/claude-code/statusline.py"
  }
}
